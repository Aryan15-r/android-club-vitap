# Copy to .env.local (git-ignored) and fill in your Supabase project values.
# Find both under Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Key typed at the hidden admin entrance on the home page.
# VITE_ variables are bundled into public JavaScript, so this is a UX gate only,
# not a security control. Real authorisation is Supabase Auth + row level
# security. Change it to any phrase you like; if unset it falls back to the
# original prototype value "admin@17".
VITE_ADMIN_ACCESS_KEY=admin@17

# There is intentionally no API base URL: the SPA talks to Supabase directly.
# (The prototype's VITE_API_BASE_URL placeholder is no longer used.)
